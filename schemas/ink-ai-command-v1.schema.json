{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ink-ai-command-v1","title":"INK AI Command","type":"object","required":["commandId","sessionId","actor","timestamp","intent","operation","scope","parameters","constraints","preconditions","expectedEffects","permissionLevel","previewRequired","approvalRequired","rollbackStrategy","timeout","deterministicSeed","dependencies","confidence","unsupportedItems","riskLevel","auditMetadata"],"properties":{"commandId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"sessionId":{"type":"string"},"actor":{"type":"object"},"timestamp":{"type":"string","format":"date-time"},"intent":{"type":"string"},"operation":{"type":"string"},"target":{},"scope":{"type":"string"},"parameters":{"type":"object"},"constraints":{"type":"object"},"preconditions":{"type":"array"},"expectedEffects":{"type":"array"},"permissionLevel":{"enum":["OBSERVE","PROPOSE","PREVIEW","EXECUTE"]},"previewRequired":{"type":"boolean"},"approvalRequired":{"type":"boolean"},"rollbackStrategy":{"type":"string"},"timeout":{"type":"number","minimum":1,"maximum":300000},"deterministicSeed":{"type":"number"},"dependencies":{"type":"array"},"confidence":{"type":"number","minimum":0,"maximum":1},"unsupportedItems":{"type":"array"},"riskLevel":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},"auditMetadata":{"type":"object"}},"additionalProperties":true}
